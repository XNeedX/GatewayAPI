      "QoSOptions": {
        "TimeoutValue": 5000,
        "MinimumThroughput": 2,
        "BreakDuration": 5000,
        "FailureRatio": 0.5,
        "SamplingDuration": 30000
      }
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "documents-api",
          "Port": 8080
        }
      ],
