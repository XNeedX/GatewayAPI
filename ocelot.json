{
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7160"
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "services-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/services/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Patch", "Delete", "Options" ],
      "SwaggerKey": "services",
      "QoSOptions": {
        "TimeoutValue": 5000,
        "MinimumThroughput": 2,
        "BreakDuration": 5000,
        "FailureRatio": 0.5,
        "SamplingDuration": 30000
      }
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
