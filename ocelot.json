  "SwaggerEndPoints": [
    {
      "Key": "services",
      "Config": [
        {
          "Name": "Services API",
          "Version": "v1",
          "Url": "http://services-api:8080/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "appointments",
      "Config": [
        {
          "Name": "Appointments API",
